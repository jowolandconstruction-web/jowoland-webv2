  <script>
    (function () {
      const viewport = document.getElementById('testi-viewport') as HTMLElement;
      const track = document.getElementById('testi-track') as HTMLElement;
      const btnPrev = document.getElementById('testi-prev') as HTMLButtonElement;
      const btnNext = document.getElementById('testi-next') as HTMLButtonElement;
      const dotsContainer = document.getElementById('testi-dots') as HTMLElement;
      if (!viewport || !track) return;

      const slides = Array.from(track.querySelectorAll<HTMLElement>('.testi-slide'));
      const total = slides.length;
      let current = 0;
      let perView = 1;
      let autoTimer: ReturnType<typeof setInterval>;

      function getPerView(): number {
        if (window.innerWidth >= 1024) return 3;
        if (window.innerWidth >= 768) return 2;
        return 1;
      }

      function getSlideWidth(): number {
        if (slides.length === 0) return 0;
        return slides[0].getBoundingClientRect().width + 24; // +gap(6 * 4px = 24px)
      }

      function buildDots() {
        dotsContainer.innerHTML = '';
        const pages = Math.ceil(total / perView);
        for (let i = 0; i < pages; i++) {
          const dot = document.createElement('button');
          dot.setAttribute('aria-label', `Halaman ${i + 1}`);
          dot.className = 'w-2.5 h-2.5 rounded-full transition-all duration-300 ' +
            (i === Math.floor(current / perView) ? 'bg-brand-500 w-6' : 'bg-foreground-muted/30 hover:bg-foreground-muted/60');
          dot.addEventListener('click', () => goTo(i * perView));
          dotsContainer.appendChild(dot);
        }
      }

      function updateDots() {
        const dots = dotsContainer.querySelectorAll<HTMLButtonElement>('button');
        const page = Math.floor(current / perView);
        dots.forEach((d, i) => {
          d.className = 'rounded-full transition-all duration-300 ' +
            (i === page ? 'bg-brand-500 w-6 h-2.5' : 'bg-foreground-muted/30 hover:bg-foreground-muted/60 w-2.5 h-2.5');
        });
      }

      function goTo(idx: number) {
        const maxPage = Math.ceil(total / perView) - 1;
        current = Math.max(0, Math.min(idx, maxPage * perView));
        const offset = getSlideWidth() * current;
        track.style.transform = `translateX(-${offset}px)`;
        updateDots();
        if (btnPrev) btnPrev.disabled = current === 0;
        if (btnNext) btnNext.disabled = current >= maxPage * perView;
      }

      function init() {
        perView = getPerView();
        current = 0;
        buildDots();
        goTo(0);
      }

      function startAuto() {
        clearInterval(autoTimer);
        autoTimer = setInterval(() => {
          const maxPage = Math.ceil(total / perView) - 1;
          goTo(current + perView > maxPage * perView ? 0 : current + perView);
        }, 5000);
      }

      btnPrev?.addEventListener('click', () => { goTo(current - perView); startAuto(); });
      btnNext?.addEventListener('click', () => { goTo(current + perView); startAuto(); });

      // Touch/swipe support
      let touchStartX = 0;
      viewport.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
      viewport.addEventListener('touchend', (e) => {
        const diff = touchStartX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 50) {
          diff > 0 ? goTo(current + perView) : goTo(current - perView);
          startAuto();
        }
      }, { passive: true });

      window.addEventListener('resize', () => { init(); startAuto(); });

      init();
      startAuto();
    })();
  </script>

