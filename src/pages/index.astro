---
import LandingLayout from '@/layouts/LandingLayout.astro';
import { Hero } from '@/components/hero';
import Button from '@/components/ui/form/Button/Button.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import ImageCtaBand from '@/components/patterns/ImageCtaBand.astro';
import { stripHtml, getProducts, formatPrice } from '@/lib/wordpress';
import { createFAQSchema, createBreadcrumbSchema } from '@/lib/schema';
import siteConfig from '@/config/site.config';

const featuredProducts = await getProducts({ per_page: 3, orderby: 'menu_order', order: 'asc' });

const waLink = 'https://api.whatsapp.com/send/?phone=6285280749218&text=Halo%20PT.%20Jowo%20Land%20Construction%2C%20saya%20ingin%20order%20layanan%20pondasi%20bore%20pile.%0A%0ANama%3A%0ALokasi%20Proyek%20%28Kota%2FKecamatan%29%3A%0AJenis%20Bangunan%20%28Rumah%2FGudang%2FRuko%29%3A%0AJumlah%20Titik%3A%0AKedalaman%3A%0ADiameter%3A';

const faqs = [
  { q: 'Apa perbedaan bore pile manual dan bore pile mesin?', a: 'Bore pile manual (strauss pile) dikerjakan tanpa mesin besar, cocok untuk lahan sempit dan proyek skala menengah. Bore pile mesin menggunakan mini crane atau hydraulic drilling rig, cocok untuk kedalaman dan kapasitas beban lebih besar.' },
  { q: 'Berapa harga jasa bore pile per meter?', a: 'Harga jasa bore pile berkisar Rp135.000 hingga Rp350.000 per meter, tergantung diameter (30-80 cm) dan metode yang digunakan (mesin mini crane atau alat berat).' },
  { q: 'Apakah bore pile aman untuk bangunan yang berdempetan?', a: 'Ya. Bore pile bekerja dengan mengekstraksi tanah, bukan memukul/mendesak tanah seperti tiang pancang, sehingga minim getaran dan aman untuk bangunan tetangga yang menempel.' },
  { q: 'Apa itu dry boring, wash boring, dan slurry boring?', a: 'Dry boring untuk tanah solid; wash boring untuk tanah berpasir/berair dengan bantuan tekanan air; slurry/casing boring untuk tanah labil menggunakan larutan bentonite agar dinding lubang tidak longsor.' },
  { q: 'Apakah perlu soil test sebelum menentukan metode pondasi?', a: 'Ya, sangat disarankan. Soil test/sondir membantu menentukan kedalaman, diameter, dan metode yang tepat sesuai kondisi tanah aktual di lokasi proyek.' },
  { q: 'Standar SNI apa yang digunakan untuk pondasi bore pile?', a: 'Kami mengikuti SNI 8460:2017 (perancangan geoteknik), SNI 2847:2019 (beton struktural), dan SNI 1726:2012 (ketahanan gempa).' },
  { q: 'Apa itu PDA Test, PIT Test, dan Static Load Test?', a: 'PDA Test mengukur daya dukung dinamis pasca-pengecoran, PIT Test mengecek keutuhan beton di dalam tanah, dan Static Load Test memvalidasi daya dukung aktual tiang secara langsung.' },
  { q: 'Apakah tersedia paket jasa termasuk material?', a: 'Ya, tersedia paket all-in (jasa + besi + beton ready mix) maupun paket jasa saja sesuai kebutuhan proyek Anda.' },
  { q: 'Wilayah mana saja yang dilayani?', a: 'Kami melayani proyek di Jawa Tengah, Jawa Timur, Jawa Barat, Yogyakarta, Jakarta, Banten, dan Bali.' },
  { q: 'Apakah bisa konsultasi dan survey lokasi gratis?', a: 'Ya, kami menyediakan konsultasi awal dan tinjauan gambar denah tanpa biaya sebelum kesepakatan kontrak kerja.' },
  { q: 'Berapa lama pengerjaan bore pile per titik?', a: 'Waktu bervariasi tergantung kedalaman dan jenis tanah; metode mesin (mini crane/hydraulic rig) umumnya lebih cepat dibanding metode manual strauss pile.' },
  { q: 'Berapa kedalaman ideal bore pile untuk rumah 2 lantai?', a: 'Kedalaman ideal ditentukan dari hasil soil test, bukan angka baku — namun umumnya berkisar 6-12 meter untuk rumah 2 lantai, tergantung kondisi tanah setempat.' },
  { q: 'Berapa diameter bore pile yang direkomendasikan untuk ruko?', a: 'Diameter 30-40 cm umumnya cukup untuk ruko 2-3 lantai, namun tetap perlu disesuaikan dengan hasil perhitungan struktur dan kondisi tanah.' },
  { q: 'Apakah bore pile lebih mahal dari tiang pancang?', a: 'Tergantung skala proyek dan kondisi lokasi. Bore pile sering lebih ekonomis untuk proyek dengan akses terbatas karena tidak memerlukan alat pancang besar dan minim getaran.' },
  { q: 'Bagaimana jika hasil pengerjaan tidak sesuai spesifikasi kontrak?', a: 'Setiap lingkup kerja dan spesifikasi sudah tertuang jelas dalam kontrak kami — bila ditemukan ketidaksesuaian, hal ini dapat ditindaklanjuti sesuai ketentuan kontrak kerja yang disepakati.' },
  { q: 'Berapa minimal volume pengerjaan untuk satu proyek?', a: 'Silakan hubungi tim kami untuk konsultasi lebih lanjut, karena minimal volume dapat menyesuaikan lokasi dan jenis proyek.' },
  { q: 'Apakah ada biaya mobilisasi alat ke lokasi proyek?', a: 'Ya, biaya mobilisasi disesuaikan dengan jarak dan aksesibilitas lokasi proyek, dan akan diinformasikan secara transparan sebelum kontrak disepakati.' },
  { q: 'Bagaimana cara menghitung jumlah titik bore pile yang dibutuhkan?', a: 'Jumlah titik dihitung berdasarkan beban struktur bangunan dan daya dukung tanah hasil soil test — tim engineer kami membantu perhitungan ini saat konsultasi.' },
  { q: 'Apa saja jenis bangunan yang bisa menggunakan jasa ini?', a: 'Rumah tinggal, ruko, gudang, pabrik, gedung bertingkat, sekolah, dan tempat ibadah — seluruhnya dapat menggunakan bore pile manual maupun mesin sesuai kebutuhan strukturnya.' },
  { q: 'Apakah PT. Jowo Land Construction pernah mengerjakan proyek BUMN?', a: 'Ya, kami telah dipercaya oleh sejumlah kontraktor besar dan BUMN seperti Hutama Karya, Waskita Karya, dan Wijaya Karya.' },
  { q: 'Apa risiko memilih kontraktor bore pile dengan harga sangat murah?', a: 'Harga yang jauh di bawah pasar berisiko pada kualitas pengerjaan, ketiadaan uji kualitas pasca-konstruksi, atau operator yang tidak bersertifikat — pekerjaan bore pile membutuhkan skill dan biaya yang tidak sedikit.' },
  { q: 'Apa itu SIO, SILO, dan NIB dalam legalitas kontraktor?', a: 'NIB adalah izin usaha resmi, SILO adalah sertifikasi kelayakan alat berat, dan SIO adalah sertifikasi operator dari Kemenaker — ketiganya wajib dimiliki kontraktor bore pile yang legal.' },
  { q: 'Apakah operator alat bor sudah bersertifikat resmi?', a: 'Ya, seluruh operator kami tersertifikasi SIO dari Kemenaker dan proyek diawasi langsung oleh engineer bersertifikat di bidang geoteknik.' },
  { q: 'Bagaimana cara memesan jasa bore pile melalui WhatsApp?', a: 'Klik tombol WhatsApp di halaman ini, sampaikan lokasi dan gambar denah (jika ada) proyek Anda, dan tim kami akan merespons dengan estimasi awal secara cepat.' },
  { q: 'Apakah bore pile mempengaruhi bangunan tetangga saat pengeboran?', a: 'Risiko sangat minim karena bore pile bekerja dengan mengekstraksi tanah secara bertahap, berbeda dengan metode pemukulan pada tiang pancang yang berisiko getaran lebih besar.' },
  { q: 'Apa yang membedakan kontraktor bore pile profesional dan yang kurang berpengalaman?', a: 'Kontraktor profesional memiliki legalitas lengkap, peralatan terawat, tenaga ahli bersertifikat, transparansi kontrak, dan menerapkan uji kualitas pasca-pengecoran (PDA/PIT/Static Load Test), bukan hanya mengandalkan harga murah.' },
  { q: 'Apakah tersedia garansi untuk pekerjaan bore pile?', a: 'Lingkup jaminan pekerjaan tertuang dalam kontrak kerja yang disepakati di awal proyek, silakan konsultasikan detailnya dengan tim kami.' },
  { q: 'Apakah bisa request jadwal pengerjaan yang cepat?', a: 'Kami menerima kuota proyek terbatas setiap bulan untuk menjaga kualitas, silakan hubungi kami sesegera mungkin untuk mengamankan jadwal proyek Anda.' },
];

const faqSchema = createFAQSchema(faqs.map(f => ({ question: f.q, answer: f.a })));
---

<LandingLayout
  title="Kontraktor Jasa Bore Pile Manual dan Mesin Harga Per Meter"
  description="Jasa bore pile manual (strauss pile) & mesin (mini crane/hydraulic rig) mulai Rp 135.000/meter. Melayani area Jawa - Bali. Konsultasi gratis via WhatsApp 0852-8074-9218."
  image="/og-default.svg"
  includeOrgSchema={true}
  includeProfessionalServiceSchema={true}
  extraSchemas={[faqSchema]}
>
  <!-- Hero -->
  <Hero layout="centered" size="xl" class="hero-dark-gradient hero-wide-desc" showScrollIndicator fullHeight>
    <Badge slot="badge" variant="brand" pill pulse class="dark:text-brand-200">Konsultasi Gratis</Badge>
    <h1 slot="title" class="!text-[clamp(1.8rem,8vw,3rem)] sm:!text-5xl md:!text-6xl lg:!text-7xl">
      <span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor]">Kontraktor Jasa Bore Pile</span><br />
      <span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor]">Manual dan Mesin Harga Per Meter</span>
    </h1>
    <p slot="description" style="max-width: 56rem;">
      PT. Jowo Land Construction adalah kontraktor jasa bore pile manual (strauss pile) dan mesin (mini crane &amp; hydraulic drilling rig) yang beroperasi sejak 2012, melayani area Jawa dan Bali. Harga jasa bore pile mulai dari Rp 135.000 per meter untuk metode mesin mini crane, hingga Rp 350.000 per meter untuk alat berat.<br /><br />
      Bore pile manual (strauss pile) dikerjakan tanpa mesin besar, cocok untuk lahan sempit dan proyek skala kecil. Bore pile mesin menggunakan mini crane atau hydraulic drilling rig, cocok untuk kedalaman dan kapasitas beban lebih besar. Seluruh pekerjaan dilakukan tenaga ahli bersertifikat Kemnaker sesuai <a href="https://sitaba.pu.go.id/publikasi/f0bd856e-e3a9-4c02-bd28-a28f90222340" target="_blank" rel="noopener noreferrer nofollow" class="font-semibold underline underline-offset-2">SNI 8460:2017</a>.
    </p>
    <Fragment slot="actions">
      <!-- Stats glass cards -->
      <div class="grid grid-cols-3 gap-3 sm:gap-4 w-full max-w-lg mx-auto mb-2">
        <div class="flex flex-col items-center gap-1.5 rounded-2xl border border-white/20 bg-white/10 backdrop-blur-md px-3 py-4 text-center shadow-lg">
          <div class="w-8 h-8 rounded-lg bg-brand-500/20 flex items-center justify-center text-brand-400 mb-0.5">
            <Icon name="thumbs-up" size="sm" />
          </div>
          <p class="text-2xl sm:text-3xl font-bold text-white autocount" data-target="98" data-suffix="%">0</p>
          <p class="text-xs font-medium text-white/70 leading-tight">Kepuasan<br/>Klien</p>
        </div>
        <div class="flex flex-col items-center gap-1.5 rounded-2xl border border-white/20 bg-white/10 backdrop-blur-md px-3 py-4 text-center shadow-lg">
          <div class="w-8 h-8 rounded-lg bg-brand-500/20 flex items-center justify-center text-brand-400 mb-0.5">
            <Icon name="users" size="sm" />
          </div>
          <p class="text-2xl sm:text-3xl font-bold text-white autocount" data-target="168" data-suffix="+">0</p>
          <p class="text-xs font-medium text-white/70 leading-tight">Klien<br/>Puas</p>
        </div>
        <div class="flex flex-col items-center gap-1.5 rounded-2xl border border-white/20 bg-white/10 backdrop-blur-md px-3 py-4 text-center shadow-lg">
          <div class="w-8 h-8 rounded-lg bg-brand-500/20 flex items-center justify-center text-brand-400 mb-0.5">
            <Icon name="hard-hat" size="sm" />
          </div>
          <p class="text-2xl sm:text-3xl font-bold text-white autocount" data-target="820" data-suffix="+">0</p>
          <p class="text-xs font-medium text-white/70 leading-tight">Proyek<br/>Selesai</p>
        </div>
      </div>
      <Button size="lg" href={waLink} target="_blank" rel="noopener noreferrer">
        <Icon name="message-circle" size="sm" />
        Hubungi via WhatsApp
        <Icon name="arrow-right" size="sm" />
      </Button>
      <Button size="lg" variant="outline" href="/contact">
        Konsultasi Gratis
        <Icon name="arrow-right" size="sm" />
      </Button>
    </Fragment>
  </Hero>


  <!-- 7. Memahami Pondasi Bored Pile (Strauss Pile) -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border overflow-x-hidden">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <Badge variant="brand" pill>Tentang Bore Pile</Badge>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
          Memahami Pondasi Bore Pile (Strauss Pile)
        </h2>
        <p class="text-lg text-foreground-muted max-w-3xl mx-auto leading-relaxed">
          <a href="https://id.wikipedia.org/wiki/Fondasi_(rekayasa)" target="_blank" rel="noopener noreferrer nofollow" class="inline-flex items-center gap-1 align-baseline font-semibold text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300 hover:underline underline-offset-4 transition-colors">
            Merujuk dari Wikipedia
            <Icon name="external-link" size="xs" class="opacity-80 -mt-0.5" />
          </a>: pondasi bore pile diklasifikasikan sebagai <strong class="text-foreground font-semibold">pondasi dalam</strong> beton berbentuk tabung silinder. Secara prinsip sejenis dengan tiang pancang (paku bumi) — sama-sama mentransfer beban bangunan menuju lapisan tanah terkeras. Bedanya, bore pile dipasang dengan cara <strong class="text-foreground font-semibold">mengebor tanah dahulu, memasukkan tulangan besi rakitan, lalu mengecor beton di tempat (in-situ)</strong>, bukan dipukul/ditancapkan seperti tiang pancang.
        </p>
        <p class="text-foreground-muted max-w-3xl mx-auto leading-relaxed">
          Karena prosesnya mengekstraksi tanah (bukan mendesak tanah), bore pile <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-brand-500/10 text-brand-600 dark:text-brand-400 text-sm font-medium border border-brand-500/20"><Icon name="zap" size="xs" class="shrink-0" />Minim Getaran</span> dan jauh lebih aman untuk bangunan yang berdempetan dengan lahan tetangga.
        </p>
        <p class="text-foreground-muted max-w-3xl mx-auto leading-relaxed">
          Untuk lebih memahami pondasi bore pile silahkan kunjungi halaman ini: <a href="https://jowolandborepile.co.id/blog/detail-pondasi-bore-pile" class="inline-flex items-center gap-1 font-semibold text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300 hover:underline underline-offset-4 transition-colors">Pondasi Bore Pile <Icon name="arrow-right" size="xs" class="opacity-80" /></a>
        </p>
      </div>

      <!-- Expandable: Pelajari Selengkapnya -->
      <div class="max-w-5xl mx-auto w-full" data-reveal>
        <details class="group/about-bore group">
          <summary class="list-none [&::-webkit-details-marker]:hidden cursor-pointer">
            <Card variant="elevated" padding="lg" class="!p-0 overflow-hidden border border-border hover:border-brand-500/30 transition-all duration-300">
              <div class="relative">
                <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-500/60 to-transparent opacity-60"></div>
                <div class="flex items-center justify-between gap-4 px-5 sm:px-7 py-4 sm:py-5">
                  <div class="flex items-center gap-3 sm:gap-4 min-w-0">
                    <div class="w-11 h-11 rounded-2xl shrink-0 bg-gradient-to-br from-brand-500/25 via-brand-500/10 to-brand-500/0 flex items-center justify-center text-brand-600 dark:text-brand-400 ring-1 ring-brand-500/20">
                      <Icon name="book-open" size="md" />
                    </div>
                    <div class="min-w-0">
                      <p class="text-sm uppercase tracking-widest text-foreground-muted/70 font-semibold">Konten Lengkap</p>
                      <p class="font-display text-lg sm:text-xl font-bold text-foreground">Pelajari Selengkapnya Tentang Bore Pile</p>
                    </div>
                  </div>
                  <div class="w-11 h-11 shrink-0 rounded-xl flex items-center justify-center bg-background-tertiary border border-border transition-all duration-300 group-open/about-bore:bg-brand-500 group-open/about-bore:border-brand-500 group-open/about-bore:shadow-lg group-open/about-bore:shadow-brand-500/20">
                    <Icon name="chevron-down" size="md" class="text-foreground-muted transition-transform duration-300 group-open/about-bore:rotate-180 group-open/about-bore:text-white" />
                  </div>
                </div>
              </div>
            </Card>
          </summary>

          <!-- Konten expandable -->
          <div class="mt-4 grid gap-6">
            <!-- Klasifikasi & Perbandingan Manual vs Mesin -->
            <Card variant="elevated" padding="lg" class="relative overflow-hidden">
              <div class="absolute -top-20 -right-20 w-64 h-64 rounded-full bg-brand-500/10 blur-3xl pointer-events-none"></div>
              <div class="relative grid gap-6">
                <div>
                  <div class="inline-flex items-center gap-2 mb-3">
                    <div class="w-8 h-8 rounded-lg bg-brand-500/15 flex items-center justify-center text-brand-600 dark:text-brand-400 shrink-0">
                      <Icon name="layers" size="sm" />
                    </div>
                    <h3 class="font-display text-xl font-bold text-foreground">Dari Segi Cara Pengerjaan — Dua Kategori Utama</h3>
                  </div>
                  <p class="text-foreground-muted leading-relaxed">Bore pile terbagi menjadi dua kategori besar yang disesuaikan dengan skala, akses lahan, dan kapasitas beban proyek Anda.</p>
                </div>

                <div class="overflow-hidden rounded-2xl border border-border">
                  <div class="grid grid-cols-5 text-xs sm:text-sm font-semibold text-foreground bg-background-tertiary/70 uppercase tracking-wide">
                    <div class="col-span-1 px-4 sm:px-5 py-4 flex items-center">Aspek</div>
                    <div class="col-span-2 px-4 sm:px-5 py-4 border-l border-border flex items-center gap-2 text-brand-700 dark:text-brand-300">
                      <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-brand-500/15 text-brand-600 dark:text-brand-400 shrink-0">
                        <Icon name="hard-hat" size="xs" />
                      </span>
                      Manual (Strauss Pile)
                    </div>
                    <div class="col-span-2 px-4 sm:px-5 py-4 border-l border-border flex items-center gap-2 text-indigo-700 dark:text-indigo-300">
                      <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 shrink-0">
                        <Icon name="settings" size="xs" />
                      </span>
                      Mesin (Mini Crane / Hydraulic Rig)
                    </div>
                  </div>
                  {[
                    { aspect: 'Alat', a: 'Manual, tanpa mesin besar', b: 'Mesin mini crane / alat berat hydraulic rig', aIcon: 'wrench', bIcon: 'drill' },
                    { aspect: 'Cocok untuk', a: 'Lahan sempit, akses terbatas, proyek skala menengah', b: 'Kedalaman & kapasitas beban lebih besar', aIcon: 'map-pin', bIcon: 'building-2' },
                    { aspect: 'Kecepatan', a: 'Lebih lambat', b: 'Lebih cepat, terutama untuk volume banyak titik', aIcon: 'clock', bIcon: 'zap' },
                    { aspect: 'Getaran', a: 'Sangat minim', b: 'Minim (tetap lebih terkontrol dibanding tiang pancang)', aIcon: 'activity', bIcon: 'activity' },
                  ].map((row, i) => (
                    <div key={i} class={`grid grid-cols-5 text-xs sm:text-sm border-t ${i % 2 === 0 ? 'bg-background/60' : ''}`}>
                      <div class="col-span-1 px-4 sm:px-5 py-3.5 flex items-center gap-2 font-medium text-foreground/90">
                        <span class="text-foreground-muted shrink-0">{row.i}</span>
                        {row.aspect}
                      </div>
                      <div class="col-span-2 px-4 sm:px-5 py-3.5 border-l border-border flex items-start gap-2.5 text-foreground-muted">
                        <span class="w-1 h-1.5 rounded-full bg-brand-500/70 mt-2 shrink-0"></span>
                        <span>{row.a}</span>
                      </div>
                      <div class="col-span-2 px-4 sm:px-5 py-3.5 border-l border-border flex items-start gap-2.5 text-foreground-muted">
                        <span class="w-1 h-1.5 rounded-full bg-indigo-500/70 mt-2 shrink-0"></span>
                        <span>{row.b}</span>
                      </div>
                    </div>
                  ))}
                </div>

                <p class="text-sm text-foreground-muted italic flex items-start gap-2 pt-1">
                  <Icon name="info" size="sm" class="text-brand-500 shrink-0 mt-0.5" />
                  Untuk memahami lebih dalam jenis-jenis pondasi bore pile beserta teknik pengeborannya, silakan lanjutkan ke bagian di bawah ini.
                </p>
              </div>
            </Card>

            <!-- Metode Pengeboran (3 cards) -->
            <Card variant="elevated" padding="lg" class="relative overflow-hidden">
              <div class="absolute -top-24 -left-24 w-72 h-72 rounded-full bg-indigo-500/10 blur-3xl pointer-events-none"></div>
              <div class="relative grid gap-6">
                <div>
                  <div class="inline-flex items-center gap-2 mb-3">
                    <div class="w-8 h-8 rounded-lg bg-indigo-500/15 flex items-center justify-center text-indigo-600 dark:text-indigo-400 shrink-0">
                      <Icon name="droplets" size="sm" />
                    </div>
                    <h3 class="font-display text-xl font-bold text-foreground">Metode Pengeboran yang Kami Gunakan</h3>
                  </div>
                  <p class="text-foreground-muted leading-relaxed">Selain memilih antara metode manual atau mesin, teknik pengeboran juga harus disesuaikan dengan kondisi tanah di lokasi proyek Anda:</p>
                </div>

                <div class="grid gap-4 md:grid-cols-3">
                  {[
                    {
                      tag: 'Dry',
                      title: 'Dry Boring',
                      desc: 'Digunakan pada kondisi tanah yang cukup kuat dan tidak mudah longsor, tanpa memerlukan bantuan cairan penstabil lubang.',
                      icon: 'sun',
                      iconWrap: 'from-amber-500/25 to-amber-500/0 text-amber-600 dark:text-amber-400 ring-amber-500/20',
                      chip: 'bg-amber-500/15 text-amber-700 dark:text-amber-300 border-amber-500/20',
                    },
                    {
                      tag: 'Wash',
                      title: 'Wash Boring',
                      desc: 'Digunakan pada tanah berpasir atau berair, memanfaatkan tekanan air untuk membantu proses pengangkatan tanah selama pengeboran berlangsung.',
                      icon: 'waves',
                      iconWrap: 'from-sky-500/25 to-sky-500/0 text-sky-600 dark:text-sky-400 ring-sky-500/20',
                      chip: 'bg-sky-500/15 text-sky-700 dark:text-sky-300 border-sky-500/20',
                    },
                    {
                      tag: 'Slurry',
                      title: 'Slurry / Casing Boring',
                      desc: 'Digunakan pada tanah yang labil dan beresiko longsor, dengan bantuan larutan bentonite atau pipa casing untuk menjaga kestabilan dinding lubang.',
                      icon: 'shield-check',
                      iconWrap: 'from-emerald-500/25 to-emerald-500/0 text-emerald-600 dark:text-emerald-400 ring-emerald-500/20',
