---
/**
 * Partial markup testimoni beranda.
 *
 * Dipisah dari index.astro agar markup slider (±39 KB) tidak ikut dalam
 * HTML awal. index.astro memuatnya lewat IntersectionObserver (rootMargin
 * 600px) begitu section mendekati layar.
 *
 * Halaman ini tidak boleh diindeks.
 */
import Badge from '@/components/ui/data-display/Badge/Badge.astro';

// Partial murni: tanpa <!doctype>, <html>, <head>, atau dev toolbar,
// sehingga HTML hasil fetch bisa langsung disuntik ke #testimoni-section.
export const partial = true;

Astro.response.headers.set('X-Robots-Tag', 'noindex');
