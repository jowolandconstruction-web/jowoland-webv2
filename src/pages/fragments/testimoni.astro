<div class="mx-auto max-w-6xl px-6 flex flex-col gap-10">
  <div class="flex flex-col items-center gap-4 text-center">
    <Badge variant="brand" pill>Testimoni</Badge>
    <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
      Testimoni Klien
    </h2>
    <p class="text-lg text-foreground-muted max-w-2xl mx-auto">
      Reputasi kami dibangun di atas integritas. Silakan tinjau ulang testimoni nyata klien kami melalui Google Business dan telah terverifikasi.
    </p>
  </div>

  <!-- Slider testimoni -->
  <div class="relative">
    <!-- Fade edges -->
    <div class="pointer-events-none absolute inset-y-0 left-0 w-16 z-10 bg-gradient-to-r from-background-secondary to-transparent hidden md:block"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-16 z-10 bg-gradient-to-l from-background-secondary to-transparent hidden md:block"></div>

    <!-- Viewport -->
    <div id="testi-viewport" class="overflow-hidden mx-auto">
