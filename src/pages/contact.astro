---
/**
 * Kontak page
 * URL: /contact
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import { Hero } from '@/components/hero';
import ContactForm from '@/components/patterns/ContactForm.astro';
import { Image } from 'astro:assets';
import founderImage from '@/assets/images/founder.jpg';

const waLink = 'https://api.whatsapp.com/send/?phone=6285280749218&text=Halo%20PT.%20Jowo%20Land%20Construction%2C%20saya%20ingin%20order%20layanan%20pondasi%20bore%20pile.%0A%0ANama%3A%0ALokasi%20Proyek%20%28Kota%2FKecamatan%29%3A%0AJenis%20Bangunan%20%28Rumah%2FGudang%2FRuko%29%3A%0AJumlah%20Titik%3A%0AKedalaman%3A%0ADiameter%3A';

const channels = [
  {
    icon: 'message-circle',
    label: 'WhatsApp',
    value: '0852-8074-9218',
    note: 'Konsultasi cepat via WhatsApp',
    href: waLink,
    external: true,
  },
  {
    icon: 'mail',
    label: 'Email',
    value: 'info@jowolandborepile.co.id',
    note: 'Kirim detail proyek via email',
    href: 'mailto:info@jowolandborepile.co.id',
    external: false,
  },
];
---

<PageLayout
  title="Kontak PT. Jowo Land Construction — Bore Pile & Strauss Pile"
  description="Hubungi PT. Jowo Land Construction untuk konsultasi, survey lokasi, dan penawaran jasa bore pile profesional di Jawa, Jakarta, Banten, dan Bali."
  eagerReveal
>
  <Hero layout="centered" size="md" class="isolate" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="message-circle" size="sm" />
      Hubungi Kami
    </Badge>
    <h1 slot="title">
      Konsultasikan Kebutuhan <span class="text-brand-500">Pondasi Anda</span>
    </h1>
    <p slot="description">
      PT. Jowo Land Construction siap membantu kebutuhan bore pile dan strauss pile untuk berbagai proyek konstruksi dengan respon cepat 24 jam.
    </p>

    <!-- Centered Founder Photo & Profile Showcase -->
    <div class="mt-6 flex flex-col items-center text-center">
      <div class="relative group">
        <!-- Glow halo around founder image -->
        <div class="absolute -inset-1.5 rounded-3xl bg-gradient-to-r from-brand-500/40 via-brand-400/20 to-brand-600/40 blur-lg opacity-75 group-hover:opacity-100 transition duration-500"></div>
        <div class="relative w-44 h-56 sm:w-52 sm:h-64 md:w-60 md:h-72 rounded-2xl overflow-hidden border-2 border-brand-500/40 shadow-2xl bg-background-secondary">
          <Image
            src={founderImage}
            alt="Achmad Fikri Ibnu Hadi - Founder & Director PT. Jowo Land Construction"
            width={480}
            height={576}
            class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-500 ease-out"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent pointer-events-none"></div>
          <div class="absolute bottom-2.5 inset-x-2 text-center text-white">
            <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-brand-500/90 text-white shadow-sm backdrop-blur-sm">
              Founder & Director
            </span>
          </div>
        </div>
      </div>

      <div class="mt-4">
        <h3 class="font-display text-xl sm:text-2xl font-bold text-foreground">
          Achmad Fikri Ibnu Hadi
        </h3>
        <p class="text-sm font-medium text-foreground-muted mt-0.5">
          PT. Jowo Land Construction
        </p>
        <p class="text-xs sm:text-sm text-brand-500 font-semibold italic mt-1">
          "Spesialis Geoteknik Rekayasa Pondasi"
        </p>
      </div>
    </div>
  </Hero>

  <!-- Kontak Section -->
  <section class="relative isolate overflow-hidden py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="relative z-10 mx-auto max-w-5xl px-6">
      <div class="grid grid-cols-1 glitch:grid-cols-5 gap-10 glitch:gap-16 items-stretch">

        <!-- Left column: contact form -->
        <div class="glitch:col-span-3 h-full sm:max-w-xl sm:mx-auto glitch:max-w-none glitch:mx-0" data-reveal="right" data-reveal-ease="smooth">
          <Card padding="lg" class="h-full flex flex-col justify-center">
            <h2 class="font-display text-xl font-bold text-foreground mb-6 sm:text-center glitch:text-left">Detail Proyek Anda</h2>
            <ContactForm />
          </Card>
        </div>

        <!-- Right column: contact channels -->
        <div class="glitch:col-span-2 space-y-4 sm:max-w-xl sm:mx-auto glitch:max-w-none glitch:mx-0" data-reveal="left" data-reveal-delay="1" data-reveal-ease="smooth">
          <div class="sm:text-center glitch:text-left">
            <h2 class="font-display text-lg font-bold text-foreground mb-1">Kontak Langsung</h2>
            <p class="text-sm text-foreground-muted">Pilih cara yang paling mudah untuk Anda.</p>
          </div>

          <div class="space-y-2">
            {channels.map((ch) => (
              <a
                href={ch.href}
                {...ch.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
                class="block group"
              >
                <Card hover padding="sm" class="h-full">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 shrink-0 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500">
                      <Icon name={ch.icon} size="sm" />
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="font-semibold text-sm text-foreground">{ch.label}</p>
                      <p class="text-xs text-foreground-muted truncate">{ch.value}</p>
                    </div>
                    <Icon name="arrow-up-right" size="sm" class="text-foreground-muted group-hover:text-brand-500 transition-colors shrink-0" />
                  </div>
                </Card>
              </a>
            ))}
          </div>

          <!-- Alamat -->
          <Card padding="sm" class="bg-brand-500/5 border-brand-500/20">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 shrink-0 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500">
                <Icon name="map-pin" size="sm" />
              </div>
              <div>
                <p class="font-semibold text-sm text-foreground">Alamat Kantor</p>
                <p class="text-xs text-foreground-muted mt-0.5">Karanganyar, Ketitang, Kec. Godong,<br />Kabupaten Grobogan, Jawa Tengah 58162</p>
              </div>
            </div>
          </Card>

          <!-- Jam Operasional -->
          <Card padding="sm">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 shrink-0 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500">
                <Icon name="clock" size="sm" />
              </div>
              <div>
                <p class="font-semibold text-sm text-foreground">Jam Operasional</p>
                <p class="text-xs text-foreground-muted mt-0.5">Buka 24 jam</p>
                <p class="text-xs text-foreground-muted">Respon cepat via WhatsApp</p>
              </div>
            </div>
          </Card>

          <!-- Area Layanan -->
          <Card padding="sm">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 shrink-0 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500">
                <Icon name="globe" size="sm" />
              </div>
              <div>
                <p class="font-semibold text-sm text-foreground">Area Layanan</p>
                <p class="text-xs text-foreground-muted mt-0.5">Jawa Tengah, Jawa Timur, Jawa Barat, Yogyakarta, Jakarta, Banten, dan Bali</p>
              </div>
            </div>
          </Card>
        </div>

      </div>
    </div>
  </section>

  <!-- Kenapa Hubungi Kami -->
  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <Badge variant="brand" pill>Kenapa Kami?</Badge>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
          Kenapa Menghubungi PT. Jowo Land Construction?
        </h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { icon: 'zap', text: 'Respon cepat' },
          { icon: 'message-circle', text: 'Konsultasi gratis' },
          { icon: 'map-pin', text: 'Survey lokasi' },
          { icon: 'users', text: 'Tenaga berpengalaman' },
          { icon: 'tag', text: 'Harga kompetitif' },
          { icon: 'globe', text: 'Jangkauan Jawa hingga Bali' },
        ].map((item) => (
          <Card hover data-reveal class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name={item.icon} size="sm" />
            </div>
            <p class="text-sm font-medium text-foreground">{item.text}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
