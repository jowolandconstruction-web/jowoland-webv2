---
/**
 * Portofolio page
 * URL: /projects
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import ImageCtaBand from '@/components/patterns/ImageCtaBand.astro';
import { getProducts, formatPrice, stripHtml } from '@/lib/wordpress';

const products = await getProducts({ per_page: 50, orderby: 'menu_order', order: 'asc' });

const waLink = 'https://api.whatsapp.com/send/?phone=6285280749218&text=Halo%20PT.%20Jowo%20Land%20Construction%2C%20saya%20ingin%20order%20layanan%20pondasi%20bore%20pile.%0A%0ANama%3A%0ALokasi%20Proyek%20%28Kota%2FKecamatan%29%3A%0AJenis%20Bangunan%20%28Rumah%2FGudang%2FRuko%29%3A%0AJumlah%20Titik%3A%0AKedalaman%3A%0ADiameter%3A';
---

<PageLayout
  title="Portofolio Jasa Bore Pile Profesional | PT. Jowo Land Construction"
  description="Lihat portofolio proyek jasa bore pile PT. Jowo Land Construction untuk rumah, gudang, gedung, dan berbagai proyek konstruksi di Pulau Jawa."
  eagerReveal
>
  <Hero layout="centered" size="sm" class="isolate" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="layers" size="sm" />
      Portofolio
    </Badge>
    <h1 slot="title">Dokumentasi Proyek Bore Pile</h1>
    <p slot="description">
      PT. Jowo Land Construction telah menangani berbagai pekerjaan jasa bore pile dan pondasi bangunan untuk kebutuhan rumah tinggal, ruko, gudang, gedung, pabrik, hingga proyek konstruksi lainnya di berbagai kota di Pulau Jawa.
    </p>
  </Hero>

  <!-- Proyek -->
  <section class="py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <Badge variant="brand" pill>Proyek Kami</Badge>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
          Proyek Jasa Bore Pile yang Telah Dikerjakan
        </h2>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto">
          Berbagai proyek pondasi bore pile yang telah kami selesaikan untuk rumah, ruko, gudang, gedung, dan pabrik di seluruh Pulau Jawa.
        </p>
      </div>

      {products.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {products.map((product, i) => {
            const img = product.images?.[0];
            const desc = stripHtml(product.short_description || product.description).slice(0, 120);
            const hasPrice = product.price && parseFloat(product.price) > 0;
            return (
              <a
                href={`/layanan/${product.slug}`}
                class="group block"
                data-reveal
                data-reveal-delay={String(i % 3)}
              >
                <Card variant="elevated" hover padding="none" class="flex flex-col h-full">
                  {img && (
                    <div class="aspect-video overflow-hidden rounded-t-xl bg-background-tertiary">
                      <img
                        src={img.src}
                        alt={img.alt || product.name}
                        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                        loading="lazy"
                        width="400"
                        height="225"
                      />
                    </div>
                  )}
                  <div class="flex flex-1 flex-col p-5">
                    <div class="flex items-start justify-between gap-2 mb-2">
                      <h3 class="font-display text-base font-bold text-foreground leading-snug">{product.name}</h3>
                      {product.on_sale && (
                        <Badge variant="brand" pill class="shrink-0 text-xs">Promo</Badge>
                      )}
                    </div>
                    {desc && (
                      <p class="text-sm text-foreground-muted leading-relaxed mb-3 flex-1">{desc}…</p>
                    )}
                    <div class="flex items-center justify-between mt-auto pt-3 border-t border-border">
                      {hasPrice ? (
                        <div>
                          {product.on_sale && product.regular_price && (
                            <p class="text-xs text-foreground-muted line-through">{formatPrice(product.regular_price)}</p>
                          )}
                          <p class="text-sm font-bold text-brand-500">{formatPrice(product.price)}</p>
                        </div>
                      ) : (
                        <p class="text-sm text-foreground-muted italic">Hubungi untuk harga</p>
                      )}
                      <span class="inline-flex items-center gap-1 text-sm font-medium text-brand-500 group-hover:gap-2 transition-all">
                        Detail <Icon name="arrow-right" size="sm" />
                      </span>
                    </div>
                  </div>
                </Card>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-12 text-foreground-muted">
          <Icon name="layers" size="lg" class="mx-auto mb-3 opacity-40" />
          <p>Data proyek sedang dimuat. Hubungi kami untuk informasi lebih lanjut.</p>
        </div>
      )}
    </div>
  </section>

  <!-- Dokumentasi Lapangan -->
  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <Badge variant="brand" pill>Dokumentasi</Badge>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
          Dokumentasi dan Portofolio Proyek
        </h2>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto">
          Bukti nyata dari dedikasi kami dapat dilihat pada rekam jejak Proyek kami.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { icon: 'drill', text: 'Proses pengeboran' },
          { icon: 'layers', text: 'Pemasangan tulangan' },
          { icon: 'droplets', text: 'Pengecoran beton' },
          { icon: 'check-circle', text: 'Quality control' },
        ].map((item) => (
          <Card hover data-reveal class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name={item.icon} size="sm" />
            </div>
            <p class="text-sm font-medium text-foreground">{item.text}</p>
          </Card>
        ))}
      </div>
      <!-- Video dokumentasi — 3 kolom 1 baris -->
      <div class="grid gap-6 md:grid-cols-3">
        {[
          { title: 'Dokumentasi Proyek Bore Pile 1', src: 'https://www.youtube.com/embed/-70H0vUf4Kg' },
          { title: 'Dokumentasi Proyek Bore Pile 2', src: 'https://www.youtube.com/embed/0zNIc-Xth8I' },
          { title: 'Dokumentasi Proyek Bore Pile 3', src: 'https://www.youtube.com/embed/p0AQB72czxk' },
        ].map((video, i) => (
          <Card hover data-reveal data-reveal-delay={String(i)} padding="none" class="overflow-hidden">
            <div class="aspect-video">
              <iframe
                src={video.src}
                title={video.title}
                class="w-full h-full"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Kenapa Klien Memilih Kami -->
  <section class="py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <Badge variant="brand" pill>Keunggulan</Badge>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
          Kenapa Banyak Klien Memilih PT. Jowo Land Construction?
        </h2>
      </div>
      <div class="flex flex-wrap gap-2 justify-center" data-reveal>
        {[
          'Pengerjaan profesional',
          'Tenaga berpengalaman',
          'Harga kompetitif',
          'Support proyek kecil & besar',
          'Survey lokasi',
          'Konsultasi gratis',
          'Area layanan luas',
        ].map((item) => (
          <Badge variant="brand" pill>{item}</Badge>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <ImageCtaBand
      backgroundImage="https://images.unsplash.com/photo-1756388812709-3d524bc42b9b?w=1920&h=800&fit=crop&q=80&auto=format"
      imageAlt="Pekerja konstruksi dan excavator di lokasi proyek bangunan"
    >
      <Badge variant="brand" pill class="mb-6">Konsultasi Gratis</Badge>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        Konsultasikan Proyek Anda Sekarang
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        Butuh jasa bore pile untuk rumah, gudang, ruko, gedung, atau proyek lainnya? Hubungi tim kami sekarang.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href={waLink} target="_blank" rel="noopener noreferrer" class="hero-btn-brand">
          <Icon name="message-circle" size="sm" />
          WhatsApp: 0852-8074-9218
        </Button>
        <Button size="lg" variant="outline" href="/contact">
          Kirim Pesan
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </ImageCtaBand>
  </section>
</PageLayout>
