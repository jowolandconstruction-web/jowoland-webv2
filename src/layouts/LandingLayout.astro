---
/**
 * LandingLayout
 * Layout wrapper for landing-style pages (marketing, demo, showcase)
 * Uses Header + Footer with landing-specific configuration
 *
 * This layout is part of the "demo" layer - it can be optionally installed
 * via CLI for users who want the full landing page experience.
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import type { Thing, WithContext } from 'schema-dts';
import { whatsappLink } from '@/config/contact';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  /** Jika true, judul diberi tambahan "— <nama situs>". Default: false. */
  suffix?: boolean;
  noindex?: boolean;
  nofollow?: boolean;
  includeOrgSchema?: boolean;
  includePersonSchema?: boolean;
  includeProfessionalServiceSchema?: boolean;
  extraSchemas?: WithContext<Thing>[];
}

const {
  title,
  description,
  image,
  imageAlt,
  suffix = false,
  noindex = false,
  nofollow = false,
  includeOrgSchema = false,
  includePersonSchema = false,
  includeProfessionalServiceSchema = false,
  extraSchemas = [],
} = Astro.props;

const waLink = whatsappLink();
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  suffix={suffix}
  noindex={noindex}
  nofollow={nofollow}
  includeOrgSchema={includeOrgSchema}
  includePersonSchema={includePersonSchema}
  includeProfessionalServiceSchema={includeProfessionalServiceSchema}
  extraSchemas={extraSchemas}
>
  <Header
    slot="header"
    position="fixed"
    shape="floating"
    variant="transparent"
    colorScheme="default"
    size="lg"
    showCta={true}
    cta={{ label: 'Konsultasi Gratis', href: waLink, icon: 'message-circle' }}
    autoHide={false}
    scrollProgressPosition="top"
    invertOnReturn={false}
  />

  <slot />

  <Footer
    slot="footer"
    layout="columns"
    columns={3}
    background="secondary"
    tagline="Spesialis Geoteknik Rekayasa Pondasi"
    copyright="© {year} {siteName}. Semua hak dilindungi."
    linkGroups={[
      {
        title: 'Layanan',
        links: [
          { label: 'Jasa Bore Pile', href: '/' },
          { label: 'Straus Pile', href: '/area-layanan/' },
          { label: 'Mini Crane', href: '/area-layanan/' },
          { label: 'Survey & Konsultasi', href: '/contact/' },
        ],
      },
      {
        title: 'Perusahaan',
        links: [
          { label: 'Tentang Kami', href: '/about/' },
          { label: 'Portofolio', href: '/projects/' },
          { label: 'Blog', href: '/blog/' },
          { label: 'Kontak', href: '/contact/' },
        ],
      },
    ]}
    legalLinks={[
      { label: 'Kebijakan Privasi', href: '/privacy/' },
      { label: 'Syarat & Ketentuan', href: '/terms/' },
    ]}
  />
</BaseLayout>
