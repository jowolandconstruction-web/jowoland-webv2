---
/**
 * PageLayout
 * Layout wrapper for standard content pages (non-landing)
 * Uses Header + Footer with content page configuration
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { whatsappLink } from '@/config/contact';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  /** Jika true, judul diberi tambahan "— <nama situs>". Default: false. */
  suffix?: boolean;
  noindex?: boolean;
  nofollow?: boolean;
  showScrollProgress?: boolean;
  eagerReveal?: boolean;
  extraSchemas?: any[];
}

const { title, description, image, imageAlt, suffix = false, noindex, nofollow, showScrollProgress = false, eagerReveal = false, extraSchemas = [] } = Astro.props;

const waLink = whatsappLink();

---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  suffix={suffix}
  noindex={noindex}
  nofollow={nofollow}
  eagerReveal={eagerReveal}
  extraSchemas={extraSchemas}
>
  <Header
    slot="header"
    position="fixed"
    shape="floating"
    variant="transparent"
    colorScheme="default"
    size="lg"
    showActiveState
    showCta={true}
    cta={{ label: 'Konsultasi Gratis', href: waLink, icon: 'message-circle' }}
    autoHide={false}
    scrollProgressPosition="top"
    invertOnReturn={false}
    showScrollProgress={showScrollProgress}
  />

  <main class="min-h-screen pt-24">
    <slot />
  </main>

  <Footer
    slot="footer"
    layout="columns"
    columns={3}
    background="secondary"
    tagline="Spesialis Geoteknik Rekayasa Pondasi"
    copyright="© {year} {siteName}. Semua hak dilindungi."
    linkGroups={[
      {
        title: 'Layanan',
        links: [
          { label: 'Jasa Bore Pile', href: '/' },
          { label: 'Straus Pile', href: '/area-layanan/' },
          { label: 'Mini Crane', href: '/area-layanan/' },
          { label: 'Survey & Konsultasi', href: '/contact/' },
        ],
      },
      {
        title: 'Perusahaan',
        links: [
          { label: 'Tentang Kami', href: '/about/' },
          { label: 'Portofolio', href: '/projects/' },
          { label: 'Blog', href: '/blog/' },
          { label: 'Kontak', href: '/contact/' },
        ],
      },
    ]}
    legalLinks={[
      { label: 'Kebijakan Privasi', href: '/privacy/' },
      { label: 'Syarat & Ketentuan', href: '/terms/' },
    ]}
  />
</BaseLayout>
