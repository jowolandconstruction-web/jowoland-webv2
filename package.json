{
  "name": "jowoland-webv2",
  "version": "1.4.1",
  "description": "PT. Jowo Land Construction — Kontraktor jasa bore pile manual & mesin (strauss pile, mini crane, hydraulic rig) untuk pondasi rumah, gedung, gudang, dan pabrik di area Jawa - Bali.",
  "type": "module",
  "author": "Achmad Fikri Ibnu Hadi",
  "license": "MIT",
  "keywords": [
